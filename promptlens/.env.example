# Copy to .env and fill in. Never commit real values.

# Firebase web API key (client-side; exposed in the browser bundle, protected by Firebase rules)
VITE_FIREBASE_API_KEY=
# Firebase auth domain (client-side)
VITE_FIREBASE_AUTH_DOMAIN=
# Firebase project ID (client-side)
VITE_FIREBASE_PROJECT_ID=
# Firebase storage bucket (client-side)
VITE_FIREBASE_STORAGE_BUCKET=
# Firebase Cloud Messaging sender ID (client-side)
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Firebase web app ID (client-side)
VITE_FIREBASE_APP_ID=

# Gemini API key (server-side only; Cloud Functions, never prefix with VITE_)
GEMINI_API_KEY=

# Microsoft Entra ID tenant ID for Graph API (server-side only; Cloud Functions)
GRAPH_TENANT_ID=
# Microsoft Entra ID app registration client ID (server-side only; Cloud Functions)
GRAPH_CLIENT_ID=
# Microsoft Entra ID app client secret (server-side only; Cloud Functions, never expose to the client)
GRAPH_CLIENT_SECRET=
